      <aliases enabled='yes' />
      <column caption='Total Spending per Customer' datatype='real' name='[Calculation_2069889962831872]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [customer_id] : SUM([revenue]) }' />
      </column>
      <column caption='AVG Spending per Customer' datatype='real' name='[Calculation_2069889962913793]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Calculation_2069889962831872])' />
      </column>
      <column caption='Spending Segment' datatype='string' name='[Calculation_2069889965981698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [customer_id] : SUM([revenue]) } &gt; 40 THEN &apos;High&apos;&#13;&#10;ELSEIF { FIXED [customer_id] : SUM([revenue]) } &gt;= 20 THEN &apos;Medium&apos;&#13;&#10;ELSE &apos;Low&apos;&#13;&#10;END' />
      </column>
      <column caption='Frequency Segment' datatype='string' name='[Calculation_2069889966055427]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF { FIXED [customer_id] : COUNTD([invoice_id]) } = 1 THEN &apos;One-time&apos;&#13;&#10;ELSEIF { FIXED [customer_id] : COUNTD([invoice_id]) } &lt;= 4 THEN &apos;Occasional&apos;&#13;&#10;ELSEIF { FIXED [customer_id] : COUNTD([invoice_id]) } &lt;= 9 THEN &apos;Regular&apos;&#13;&#10;ELSE &apos;Frequent&apos;&#13;&#10;END' />
      </column>
      <column caption='Customer Name' datatype='string' name='[Calculation_2069889970405380]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[customer_first_name] + &quot; &quot; + [customer_last_name]' />
      </column>
      <column caption='Employee Name' datatype='string' name='[Calculation_2069889970987013]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[employee_first_name] + &quot; &quot; + [employee_last_name]' />
      </column>
